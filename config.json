{
  "model": {
    "name": "zai-org/GLM-OCR",
    "local_path": "C:\\Users\\ASUS\\important_files\\py_local\\glm_ocr\\models\\GLM-OCR",
    "device": "auto",
    "dtype": "float16",
    "max_new_tokens": 4096,
    "max_new_tokens_limit": 8192,
    "use_local_only": true,
    "quantization": "8bit",
    "performance_mode": "balanced"
  },
  "ocr": {
    "language": "简体中文",
    "prompt_type": "text_recognition",
    "output_format": "txt"
  },
  "batch": {
    "enabled": false,
    "recursive": false,
    "output_dir": "./output",
    "filename_format": "[OCR]_{name}_{date}",
    "date_format": "%Y%m%d_%H%M%S",
    "save_mode": "single_pdf"
  },
  "ui": {
    "theme": "light",
    "font_family": "Microsoft YaHei UI",
    "font_size": 12,
    "window_size": "1200x800",
    "language": "简体中文",
    "screenshot_reminder_disabled": true,
    "minimize_to_tray": null,
    "auto_start": true,
    "fix_formula_mode": null,
    "fix_formula_completion_reminder_disabled": false,
    "clipboard_monitor": false
  },
  "api": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 18000,
    "mode": "local",
    "remote_url": "http://127.0.0.1:18000",
    "remote_host": "127.0.0.1",
    "remote_port": 18000,
    "remote_timeout": 60,
    "auto_load_model": true,
    "max_image_size_mb": 10
  },
  "app": {
    "startup_mode": "ui+api"
  }
}